diff --git a/bench/tools/phonedriver.mjs b/bench/tools/phonedriver.mjs
new file mode 100644
index 0000000..c0744d9
--- /dev/null
+++ b/bench/tools/phonedriver.mjs
@@ -0,0 +1,22 @@
+// phonedriver: its MCP server (`phonedriver mcp`), the binary in $BENCH_TOOLS/bin. Its instructions: read with
+// snapshot, act on a ref or on the text the screen shows (role narrows it), type with into; every action answers with
+// what changed on the settled screen. A password goes in with secret: true, as its docs ask.
+import { execFileSync } from "node:child_process";
+import { join } from "node:path";
+import { LABELS } from "./lib.mjs";
+const bin = () => join(process.env.BENCH_TOOLS ?? "", "bin", "phonedriver");
+const type = (field, text) => ({ text, into: LABELS[field], ...(field === "password" ? { secret: true } : {}) });
+const tap = (what) => ({ target: LABELS[what], role: "button" });
+export default {
+  id: "phonedriver", name: "phonedriver", kind: "mcp",
+  server: (ctx) => ({ command: bin(), args: ["mcp"], env: { PHONEDRIVER_DEVICE: `sim:${ctx.udid}`, PHONEDRIVER_HOME: join(process.env.BENCH_TOOLS ?? "", "phonedriver-home") } }),
+  version: () => execFileSync(bin(), ["--version"], { encoding: "utf8" }).trim(),
+  async setup(ctx) { await ctx.call("launch", { app: ctx.bundleId }, { timeoutMs: 600_000 }); },
+  async read(ctx) { await ctx.call("snapshot", { diff: false }); },
+  async tap(ctx, what) { await ctx.call("tap", tap(what)); },
+  async type(ctx, field, text) { await ctx.call("type", type(field, text)); },
+  async batch(ctx, list) {
+    await ctx.call("batch", { steps: list.map(([what, field, value]) => (what === "type" ? { tool: "type", ...type(field, value) } : { tool: "tap", ...tap(field) })) });
+  },
+  cleanup: ["PhonedriverRunner", "phonedriver-home"],
+};
